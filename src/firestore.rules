rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.userRole == 'admin';
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(userId);
    }

    match /userProfiles/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
    }

    // Buyer Request Marketplace
    match /requests/{requestId} {
      // Anyone signed in (Sellers) can browse requests
      allow read: if isSignedIn();
      // Only the buyer can create and manage their own request
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isAdmin());
    }

    // Seller Offers/Pitches
    match /offers/{offerId} {
      // Buyers can read offers for their requests, Sellers can read their own offers
      allow read: if isSignedIn();
      // Sellers can create offers
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // Chat System Rules (Synced with collection name 'chats')
    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      match /comments/{commentId} { allow read, create: if isSignedIn(); }
      match /reviews/{reviewId} { allow read, create: if isSignedIn(); }
    }
    
    match /sellerShops/{shopId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == shopId || isAdmin());
    }

    match /liveSessions/{sessionId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == sessionId || isAdmin());
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /supportTickets/{ticketId} {
        allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isSignedIn();
    }

    match /complaints/{complaintId} {
        allow create: if isSignedIn();
        allow read: if isSignedIn() && (resource.data.complainantId == request.auth.uid || isAdmin());
    }
    
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn(); 
    }
    
    // Wallet Transactions
    match /walletTransactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'platform_revenue' || resource.data.userId == 'tax_collected');
    }
    
    // Payouts
    match /payouts/{payoutId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }

    // Resell Activities Ledger
    match /resellActivities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
  }
}