
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Aligned to "One by One" build: Currently only validating Title and Metadata
    function requestFieldsValid() {
      return
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.status == "open" &&
        request.resource.data.offersCount == 0;
    }

    // =========================
    // USER PROFILES
    // =========================
    match /userProfiles/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);
    }

    // =========================
    // MARKETPLACE LEADS (REQUESTS)
    // =========================
    match /requests/{requestId} {
      // Anyone signed in (Sellers/Buyers) can read broadcasts
      allow read: if isSignedIn();
      
      // Buyer can create request with validated fields
      allow create: if isSignedIn() && requestFieldsValid();

      // Buyer can manage their own request
      allow update, delete: if isOwner(resource.data.buyerId);
    }

    // =========================
    // PRODUCT & LIVE ACCESS
    // =========================
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    match /sellerShops/{shopId} {
      allow read: if true;
      allow write: if isOwner(shopId);
    }

    match /liveSessions/{sessionId} {
      allow read: if true;
      allow write: if isOwner(sessionId);
    }

    // =========================
    // CHATS & MESSAGES
    // =========================
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
      match /messages/{messageId} {
        allow read, create: if isSignedIn();
      }
    }

    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    match /payments/{paymentId} {
      allow read, create: if isSignedIn();
    }

    // =========================
    // DEFAULT DENY
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
