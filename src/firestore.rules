
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function requestFieldsValid() {
      return
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.description is string &&
        request.resource.data.category is string &&
        request.resource.data.minBudget is number &&
        request.resource.data.maxBudget is number &&
        request.resource.data.county is string &&
        request.resource.data.area is string &&
        request.resource.data.status == "open" &&
        request.resource.data.requestType is string &&
        request.resource.data.offersCount == 0;
    }

    // =========================
    // USER PROFILES COLLECTION
    // =========================
    match /userProfiles/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);
    }

    // =========================
    // REQUESTS COLLECTION
    // =========================
    match /requests/{requestId} {

      // Anyone can read requests
      allow read: if true;

      // Buyer can create request
      allow create: if isSignedIn() && requestFieldsValid();

      // Buyer can update own request
      allow update: if isOwner(resource.data.buyerId);

      // Buyer can delete own request
      allow delete: if isOwner(resource.data.buyerId);

      // =========================
      // OFFERS SUBCOLLECTION
      // =========================
      match /offers/{offerId} {

        // Buyer and seller can read offers
        allow read: if isSignedIn();

        // Any signed-in seller can submit offer
        allow create: if isSignedIn() &&
          request.resource.data.sellerId == request.auth.uid;

        // Seller can edit own offer
        allow update, delete: if
          isSignedIn() &&
          resource.data.sellerId == request.auth.uid;
      }
    }

    // =========================
    // CHATS COLLECTION
    // =========================
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, create: if isSignedIn();
      }
    }

    // =========================
    // NOTIFICATIONS
    // =========================
    match /notifications/{notificationId} {
      allow read, create, update: if isSignedIn();
    }

    // =========================
    // PAYMENTS
    // =========================
    match /payments/{paymentId} {
      allow read, create: if isSignedIn();
    }

    // =========================
    // REVIEWS
    // =========================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if
        isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // =========================
    // PRODUCTS & SESSIONS
    // =========================
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    match /liveSessions/{sessionId} {
      allow read: if true;
      allow write: if isOwner(sessionId);
    }

    match /sellerShops/{shopId} {
      allow read: if true;
      allow write: if isOwner(shopId);
    }

    // =========================
    // DEFAULT DENY
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
