
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Defensive admin check: most profiles store the role in userRole, but
    // some legacy/Google-created profiles only have `role`. Also treats
    // admins/{uid} documents as an admin source of truth when present.
    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.userRole == 'admin' ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // =========================
    // USER PROFILES
    // =========================
    match /userProfiles/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow list: if isSignedIn() && (request.auth.uid == userId || resource.data.referredBy == request.auth.uid || isAdmin());
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }

      allow update: if isOwner(userId) ||
                      (isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verificationStatus', 'userRole', 'aiPoints'])) ||
                      (request.resource.data.aiPoints == resource.data.aiPoints + 5 && isSignedIn());
      allow delete: if isAdmin();
    }

    // =========================
    // TIKTOK CREDENTIALS (Social Reach)
    // =========================
    // Server-only: read and written exclusively by the Firebase Admin SDK
    // (src/lib/tiktok/store.ts). Clients are denied outright — access and
    // refresh tokens must never be reachable from a browser.
    match /tiktok_connections/{uid} {
      allow read, write: if false;
    }

    // =========================
    // GROWTH EVENTS (Growth Engine Phase 1)
    // =========================
    // Server-only event stream written by POST /api/events through the Admin
    // SDK. Clients are denied outright: docs carry hashed viewer ids and
    // day-bucket dedupe keys, and a client-writable event log would be a
    // fake-engagement faucet.
    match /contentEvents/{eventId} {
      allow read, write: if false;
    }

    // =========================
    // VIDEO STUDIO DRAFTS (Video Studio)
    // =========================
    // Private workspace of one seller: drafts, render state and the
    // published back-reference of `studioVideos/{videoId}`. Owner-only
    // (plus admin) — a draft or a failed upload must never be visible to
    // other sellers or the public. The PUBLIC copy of a published video is
    // the `products` document /api/video-studio/publish creates; Discovery
    // and the public shop read only `products`, never this collection.
    match /studioVideos/{videoId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId;
      allow delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // =========================
    // PRODUCT & LIVE ACCESS
    // =========================
    match /products/{productId} {
      allow read, list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      
      // MERCHANT AUTONOMY: Streamlined owner permission allows all inventory metadata updates.
      // Crucial: We only block unauthorized sellerId changes.
      // GROWTH SPINE (Phase 1): `viewCount`/`clickCount` are SERVER-OWNED —
      // only POST /api/events (Admin SDK) may write them, even for the owner
      // of the listing. Diff-based, so a normal edit (which never resends
      // these fields) and an unchanged merge are unaffected; `likes`,
      // `inCartCount` and `salesCount` stay client-writable everywhere.
      // PROPOSED — review required; do not deploy without approval.
      allow update: if (isOwner(resource.data.sellerId) && (!('sellerId' in request.resource.data) || request.resource.data.sellerId == resource.data.sellerId) &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewCount', 'clickCount'])) ||
                      (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'inCartCount', 'salesCount']));
      allow delete: if isOwner(resource.data.sellerId) || isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      }
      
      match /comments/{commentId} {
        allow read, list: if true;
        allow create: if isSignedIn();
      }
    }

    match /sellerShops/{shopId} {
      allow read: if true;
      // GROWTH SPINE (Phase 1): split the former blanket `write` so the
      // server-owned `clickCount` (share taps) and `followers` (written only
      // by /api/follow, Admin SDK) can never be set client-side — not even by
      // the shop owner. Owner updates are diff-checked, so the partial merge
      // patches the settings/account/branding screens send keep working.
      // PROPOSED — review required; do not deploy without approval.
      allow create, delete: if isOwner(shopId) || isAdmin();
      allow update: if isAdmin() || (isOwner(shopId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['clickCount', 'followers']));
    }

    match /liveSessions/{sessionId} {
      allow read: if true;
      allow write: if isOwner(sessionId) || isAdmin();
      
      match /chat/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // =========================
    // ORDERS & FINANCE
    // =========================
    match /orders/{orderId} {
       // resource-based conditions cannot be evaluated on a bare list() of the
       // whole collection — admins list everything; everyone else needs a filter
       // the rules engine can verify per-document (buyer/seller/reseller).
       allow list, read: if isAdmin()
         || (isSignedIn() && resource.data.buyerId == request.auth.uid)
         || (isSignedIn() && resource.data.sellerId == request.auth.uid)
         || (isSignedIn() && resource.data.resellerId == request.auth.uid);
       allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
       allow update: if isSignedIn();
       allow delete: if isOwner(resource.data.sellerId) || isAdmin();
    }

    // =========================
    // REQUEST MARKETPLACE (spec §24–39)
    // =========================
    // Requests: briefs are semi-public (sellers browse open requests), but
    // media attachment is private and controlled through /api/media/serve —
    // the browser never touches these collections directly.
    match /requests/{requestId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin() || isOwner(resource.data.customerId);
      allow delete: if isAdmin() || isOwner(resource.data.customerId);
    }

    match /offers/{offerId} {
      // Offers are visible to their seller, the request's customer, and admins.
      // The customer check uses a get() on the parent request.
      allow read: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/requests/$(resource.data.requestId)).data.customerId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAdmin() || isOwner(resource.data.sellerId);
    }

    // Media records are metadata only; file bytes flow through the
    // authorization-checked /api/media/serve route (admin SDK).
    match /media/{mediaId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }
    
    match /payouts/{payoutId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /walletTransactions/{transactionId} {
        allow create: if false; 
        allow read, list: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // =========================
    // SYSTEM & MARKETING
    // =========================
    match /homepageSlides/{slideId} {
        allow read, list: if true;
        allow write: if isAdmin();
    }
    
    match /helpArticles/{articleId} {
        allow read, list: if true;
        allow write: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow list, read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /complaints/{complaintId} {
      allow create: if isSignedIn() && request.resource.data.complainantId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow list, read, update: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn() && request.resource.data.participantIds.size() == 2 && request.auth.uid in request.resource.data.participantIds;
      // Deleting a conversation was silently denied before this rule existed:
      // the client removed the row optimistically, the server rejected the
      // write, and the chat popped straight back — which read as "my messages
      // vanished and then came back". Delete is scoped to a participant (or an
      // admin) so nobody outside the conversation can remove it.
      allow delete: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    // CUSTOMER CARE.
    //
    // One support thread per account, keyed by the account's own uid. That key
    // choice is the whole access-control story: a seller can only ever reach
    // `supportThreads/<their own uid>`, and the platform reads the collection to
    // see every thread. There is no query a seller could write that returns
    // somebody else's conversation.
    match /supportThreads/{uid} {
      allow read, update: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      match /messages/{messageId} {
        allow read, create: if isSignedIn();
        // Replies are append-only: once a message is in the thread nobody edits
        // or deletes it, so what a seller and an agent each said stays intact.
        allow update, delete: if false;
      }
    }

    match /payments/{paymentId} {
      allow read, create: if isSignedIn();
    }

    match /errorLogs/{errorId} {
      allow create: if true;
      allow read, list: if isAdmin();
    }

    // =========================
    // ADMIN SYSTEM LOGS & QUEUES
    // (written by Functions/admin SDK; admins read from the dashboard)
    // =========================
    match /activityLogs/{logId} {
      allow read, list: if isAdmin();
      allow create: if isSignedIn();
    }

    match /admins/{adminId} {
      allow read, list: if isAdmin();
    }

    match /contentModerationQueue/{itemId} {
      allow read, list: if isAdmin();
      allow create: if isSignedIn();
    }

    match /fraudAlerts/{alertId} {
      allow read, list: if isAdmin();
    }

    match /adminChat/{chatId} {
      allow read, list: if isAdmin();
      match /messages/{messageId} {
        allow read, write: if isAdmin();
      }
    }

    match /resellActivities/{activityId} {
      allow read, list: if isSignedIn() && (resource.data.resellerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.resellerId == request.auth.uid || request.resource.data.sellerId == request.auth.uid);
    }

    // =========================
    // COMMUNICATION ENGINE (Vidnov)
    // =========================
    match /emailLogs/{logId} {
      allow read, list: if isAdmin();
    }

    match /devMailbox/{mailId} {
      allow read, list: if isAdmin();
    }

    match /securityEvents/{eventId} {
      allow read, list: if isAdmin();
      allow create: if isSignedIn();
    }

    match /userSessions/{sessionId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // passwordResetTokens / passwordResetRequests / passwordResetRequests
    // are intentionally NOT readable by any client — the admin SDK only.

    // =========================
    // =========================
    // REFERRALS
    // =========================
    // One document per invited signup. The referrer reads their own; the
    // invitee may create exactly one (their own signup) but never edit it —
    // otherwise a user could rewrite who referred them and farm points by
    // pointing every signup at whoever pays best.
    //
    // Listing is per-referrer only. There is deliberately no "list everything"
    // for non-admins, because a leaderboard across all users would leak who is
    // recruiting whom; the admin surface below is the one place that is visible.
    match /referrals/{referralId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.referrerId == request.auth.uid)
        || (isSignedIn() && resource.data.refereeId == request.auth.uid);
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.referrerId == request.auth.uid);

      // Self-referral is blocked here as well as in the app, because the app
      // check is client-side and therefore advisory only.
      allow create: if isSignedIn()
        && request.resource.data.referrerId != request.auth.uid
        && request.resource.data.refereeId == request.auth.uid
        && request.resource.data.referrerId is string
        && request.resource.data.status == 'pending';

      // Only an admin may approve, flag or reject. A referrer editing their
      // own row could flip a flagged referral back to approved and re-claim
      // the points.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =========================
    // PUSH SUBSCRIPTIONS
    // =========================
    // Written ONLY by the Admin SDK from `/api/notifications/push/subscribe`.
    //
    // `allow write: if false` is the point of this block, not an oversight. A
    // push token is a bearer credential: `allow write: if isOwner(uid)` would
    // let any signed-in user paste another device's token into their own
    // subtree and start receiving that person's order and payment alerts.
    // Refusing client writes entirely means the only way in is a route that
    // verified the caller's ID token.
    match /pushSubscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // =========================
    // USER SETTINGS
    // =========================
    // Per-user settings such as push category preferences. Scoped under the
    // user's own uid so no query can return somebody else's settings.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /settings/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // =========================
    // REFERRAL CODE DIRECTORY
    // =========================
    // An index mapping invite code -> uid, so resolving a code at signup is a
    // point read instead of a scan of every profile.
    //
    // Public READ, deliberately. The document contains nothing but a code and
    // an opaque uid — it is the same information a referral link already puts
    // in the URL, and requiring auth here would gain nothing while making the
    // directory useless to the server-side claim path.
    //
    // Client WRITES denied: the directory is derived data, and a client that
    // could write it could point any code at its own uid and claim a referral
    // for a user who never invited anyone.
    match /referralCodes/{code} {
      allow read: if true;
      allow write: if false;
    }

    // =========================
    // REFERRAL REDEMPTIONS
    // =========================
    // The ledger of points a user has spent, written server-side by
    // `/api/referrals/redeem` inside a transaction.
    //
    // Client writes denied: the ledger is what makes a balance auditable, and
    // a client that could write it could invent entries to explain a balance
    // it had already spent. `update` is admin-only so a queued cash payout can
    // only be marked paid by a human — a referral balance can never become a
    // silent automated payment.
    match /referralRedemptions/{redemptionId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // DEFAULT DENY
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
