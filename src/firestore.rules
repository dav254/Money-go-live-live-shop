
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.userRole == 'admin';
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner(userId);
    }

    match /userProfiles/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
    }

    // Buyer Request Marketplace
    match /requests/{requestId} {
      // Sellers can browse all open requests, Buyers can see their own
      allow read: if isSignedIn();
      // Only the buyer can create a request with their ID
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      // Allow sellers to increment the offersCount
      allow update: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid || 
        isAdmin() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offersCount', 'updatedAt']))
      );
      allow delete: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isAdmin());
    }

    // Seller Offers/Pitches
    match /offers/{offerId} {
      // Access granted to the involved parties and admins
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // Chat System Rules
    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      match /comments/{commentId} { allow read, create: if isSignedIn(); }
      match /reviews/{reviewId} { allow read, create: if isSignedIn(); }
    }
    
    match /sellerShops/{shopId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == shopId || isAdmin());
    }

    match /liveSessions/{sessionId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == sessionId || isAdmin());
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /supportTickets/{ticketId} {
        allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isSignedIn();
    }

    match /complaints/{complaintId} {
        allow create: if isSignedIn();
        allow read: if isSignedIn() && (resource.data.complainantId == request.auth.uid || isAdmin());
    }
    
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn(); 
    }
    
    match /walletTransactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'platform_revenue' || resource.data.userId == 'tax_collected');
    }
    
    match /payouts/{payoutId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }

    match /resellActivities/{activityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
  }
}
