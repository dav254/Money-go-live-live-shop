
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profiles
    match /userProfiles/{userId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isOwner(userId);
    }

    // BUYER REQUESTS
    match /requests/{requestId} {
      // Any logged-in user can read requests
      allow read: if isSignedIn();
      // Any logged-in user can create a request broadcast
      allow create: if isSignedIn();
      // Only the buyer who created the request can update or delete it
      allow update, delete: if isSignedIn() && resource.data.buyerId == request.auth.uid;
    }

    // SELLER OFFERS (Pitches)
    match /offers/{offerId} {
      // Relevant parties can read offers
      allow read: if isSignedIn();
      // Any logged-in user can create an offer (Seller pitching)
      allow create: if isSignedIn();
      // Seller can edit own offer, Buyer can update status (accept/reject)
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || request.resource.data.buyerId == request.auth.uid);
      // Only the seller who created the offer can delete it
      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // CHATS & MESSAGES
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // PRODUCTS & REVIEWS
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      match /comments/{commentId} { allow read, create: if isSignedIn(); }
      match /reviews/{reviewId} { allow read, create: if isSignedIn(); }
    }
    
    // SHOPS & SESSIONS
    match /sellerShops/{shopId} {
      allow read: if true;
      allow write: if isOwner(shopId);
    }

    match /liveSessions/{sessionId} {
      allow read: if true;
      allow write: if isOwner(sessionId);
    }

    // ORDERS
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    // SUPPORT & COMPLAINTS
    match /supportTickets/{ticketId} {
        allow read: if isSignedIn() && (resource.data.userId == request.auth.uid);
        allow create: if isSignedIn();
    }

    match /complaints/{complaintId} {
        allow create: if isSignedIn();
        allow read: if isSignedIn() && (resource.data.complainantId == request.auth.uid);
    }
    
    // NOTIFICATIONS & TRANSACTIONS
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn(); 
    }
    
    match /walletTransactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid);
    }
    
    match /payouts/{payoutId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid);
      allow create: if isSignedIn();
    }
  }
}
