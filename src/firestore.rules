
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Simplified validation for "one-by-one" build process
    function requestFieldsValid() {
      return
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.status == "open" &&
        request.resource.data.offersCount == 0;
    }

    // =========================
    // USER PROFILES COLLECTION
    // =========================
    match /userProfiles/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);
    }

    // =========================
    // REQUESTS COLLECTION
    // =========================
    match /requests/{requestId} {

      // Anyone can read requests
      allow read: if true;

      // Buyer can create request (Only title is currently required by UI)
      allow create: if isSignedIn() && requestFieldsValid();

      // Buyer can update own request
      allow update: if isOwner(resource.data.buyerId);

      // Buyer can delete own request
      allow delete: if isOwner(resource.data.buyerId);

      // =========================
      // OFFERS SUBCOLLECTION
      // =========================
      match /offers/{offerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      }
    }

    // =========================
    // PRODUCT & SHOP ACCESS
    // =========================
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    match /sellerShops/{shopId} {
      allow read: if true;
      allow write: if isOwner(shopId);
    }

    match /liveSessions/{sessionId} {
      allow read: if true;
      allow write: if isOwner(sessionId);
    }

    // =========================
    // CHATS & MESSAGES
    // =========================
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
      match /messages/{messageId} {
        allow read, create: if isSignedIn();
      }
    }

    // =========================
    // NOTIFICATIONS & PAYMENTS
    // =========================
    match /notifications/{notificationId} {
      allow read, create, update: if isSignedIn();
    }

    match /payments/{paymentId} {
      allow read, create: if isSignedIn();
    }

    // =========================
    // DEFAULT DENY
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
