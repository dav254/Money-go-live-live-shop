
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    match /products/{userId}/{allPaths=**} {
      allow read;
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /requests/{userId}/{allPaths=**} {
      allow read;
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /offers/{userId}/{allPaths=**} {
      allow read;
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /shops/{userId}/{allPaths=**} {
      allow read;
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }
    
    match /support/{userId}/{allPaths=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /delivery_proofs/{allPaths=**} {
       allow read, write: if isSignedIn();
    }
    
    match /chats/{chatId}/{allPaths=**} {
       allow read, write: if isSignedIn();
    }
  }
}
