rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match any file in the 'products' folder
    match /products/{userId}/{allPaths=**} {
      // Allow public read access for all product media
      allow read;
      // Allow write access (create, update, delete) only if the user is authenticated
      // and the {userId} in the path matches their own user ID.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
