
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Match any file in the 'products' folder
    // Pattern: products/{userId}/{filename}
    match /products/{userId}/{allPaths=**} {
      // Public read for marketplace visibility
      allow read: if true;
      // Write access only for the owner of the folder
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }
    
    // Match shop branding (logos, banners)
    match /shops/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }
    
    // Match support evidence and documents
    match /support/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Match delivery proofs
    match /delivery_proofs/{allPaths=**} {
       allow read: if isSignedIn();
       allow write: if isSignedIn();
    }
    
    // Allow chats media
    match /chats/{chatId}/{allPaths=**} {
       allow read: if isSignedIn();
       allow write: if isSignedIn();
    }
  }
}
