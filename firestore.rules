
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read their own profile and admins to read any profile
    match /userProfiles/{userId} {
      allow read: if request.auth.uid == userId || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SuperAdmin';
      allow write: if request.auth.uid == userId;
    }

    // Allow admins to read/write admin documents
    match /admins/{adminId} {
      allow read, write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SuperAdmin';
    }
    
    // Secure chat messages
    match /chats/{chatId} {
      // Allow read/write access to chat metadata only if the user is a participant
      allow read, write: if request.auth.uid in resource.data.participantIds;
      
      match /messages/{messageId} {
        // Allow read/write access to messages only if the user is a participant of the parent chat
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }

    // WARNING: These rules are insecure for some collections and for temporary development only.
    // We MUST restore proper security rules before going live.
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }
    match /payments/{paymentId} {
      allow read, write: if request.auth != null;
    }
    match /aiProductDescriptions/{descId} {
      allow read, write: if request.auth != null;
    }
    match /categories/{categoryId} {
      allow read, write: if request.auth != null;
    }
    match /sellerShops/{shopId} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
  }
}

    