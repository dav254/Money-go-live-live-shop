
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: These rules are insecure and for temporary development only.
    // They allow any authenticated user to read and write to any document.
    // We MUST restore proper security rules before going live.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
