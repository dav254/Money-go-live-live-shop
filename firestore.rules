
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.userRole == 'admin';
    }

    match /userProfiles/{userId} {
      allow read: if true;
      allow list: if isSignedIn() && (request.auth.uid == userId || resource.data.referredBy == request.auth.uid || isAdmin());
      allow update: if isOwner(userId) ||
                      (isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verificationStatus', 'userRole', 'aiPoints'])) ||
                      (request.resource.data.aiPoints == resource.data.aiPoints + 5 && isSignedIn());
      allow create: if isSignedIn();
      allow delete: if isAdmin();
      
      // Fixed: Explicitly allow access to subcollections for the owner
      match /cart/{document=**} {
        allow read, write: if isOwner(userId);
      }
      match /paymentMethods/{document=**} {
        allow read, write: if isOwner(userId);
      }
      match /payoutMethods/{document=**} {
        allow read, write: if isOwner(userId);
      }
      match /wishlist/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /boost_requests/{boostId} {
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.sellerId;
      allow list: if isSignedIn() && (request.auth.uid == resource.data.sellerId || isAdmin());
      allow read: if isSignedIn() && (request.auth.uid == resource.data.sellerId || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    match /sellerShops/{shopId} {
      allow read: if true;
      allow update: if isOwner(shopId) && !('followers' in request.resource.data);
      allow write: if isOwner(shopId) || isAdmin();
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if 
        (isSignedIn() && resource.data.sellerId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['name', 'description', 'price', 'wasPrice', 'stock', 'category', 'tags', 'imageUrl', 'imageUrls', 'videoUrl', 'videoUrls', 'shippingCost', 'location', 'deliveryOptions', 'isResellable', 'commissionRate', 'updatedAt']))
        ||
        (isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'viewCount', 'inCartCount']));
      allow delete: if (isSignedIn() && resource.data.sellerId == request.auth.uid) || isAdmin();

      match /comments/{commentId} {
        allow list, read: if true;
        allow create: if isSignedIn();
      }
      match /reviews/{reviewId} {
          allow read, list: if true;
          allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      }
    }

    match /orders/{orderId} {
       allow list, read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.resellerId == request.auth.uid || isAdmin());
       allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
       allow update: if isSignedIn();
       allow delete: if isSignedIn() && (isAdmin() || resource.data.sellerId == request.auth.uid);
    }
    
    match /payouts/{payoutId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /walletTransactions/{transactionId} {
        allow create: if false; 
        allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /liveSessions/{sessionId} {
      allow read: if true;
      allow create, update: if isOwner(sessionId) || isAdmin();
      match /chat/{messageId} { allow read, write: if isSignedIn(); }
    }

    match /supportTickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow list, read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /complaints/{complaintId} {
      allow create: if isSignedIn() && request.resource.data.complainantId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow list, read, update: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn() && request.resource.data.participantIds.size() == 2 && request.auth.uid in request.resource.data.participantIds;
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /homepageSlides/{slideId} {
        allow read, list: if true;
        allow write: if isAdmin();
    }
    
    match /helpArticles/{articleId} {
        allow read: if true;
        allow write: if isAdmin();
    }
    
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
    }
  }
}
