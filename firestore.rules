
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- MODIFIED: Seller profiles are now publicly readable. ---
    // Writes are restricted to the seller or an admin.
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if request.auth.uid == sellerId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read and update their own profile.
    match /userProfiles/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
    }

    // Products are publicly readable.
    // Sellers can create/update their own products.
    match /products/{productId} {
      allow read: if true;
      allow list: if request.auth != null;
      // Allow create if the incoming document's sellerId matches the user's UID.
      allow create: if request.resource.data.sellerId == request.auth.uid;
      // Allow update/delete if the existing document's sellerId matches the user's UID.
      allow update, delete: if resource.data.sellerId == request.auth.uid;
    }

    // Orders can be read by the buyer and by admins.
    // Buyers can create orders.
    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.buyerId == request.auth.uid || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin');
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin';
    }

    // Categories are publicly readable
    match /categories/{categoryId} {
        allow read: if true;
        allow write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Other collections, keeping them restricted.
    match /payments/{paymentId} {
      allow read, write: if request.auth != null;
    }
    match /aiProductDescriptions/{descId} {
      allow read, write: if request.auth != null;
    }
    match /sellerShops/{shopId} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
    match /admins/{adminId} {
      allow read, write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SuperAdmin';
    }
    match /chats/{chatId} {
      allow read, write: if request.auth.uid in resource.data.participantIds;
      
      match /messages/{messageId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
