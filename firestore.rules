
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and update their own profile.
    // Public read is now allowed for user profiles.
    match /userProfiles/{userId} {
      allow read: if true;
      allow update: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
      
      // A user can only read and write to their own cart.
      match /cart/{productId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // SellerShops are now publicly readable.
    // Writes are restricted to the seller or an admin.
    match /sellerShops/{shopId} {
      allow read: if true;
      // shopId should be the same as sellerId (user UID)
      allow write: if request.auth.uid == shopId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.userRole == 'admin';
    }

    // Products are publicly readable.
    match /products/{productId} {
      allow read: if true;
      allow list: if request.auth != null;
      // Allow create if the incoming document's sellerId matches the user's UID.
      allow create: if request.resource.data.sellerId == request.auth.uid;
      
      // - Allow product owner to update any field.
      // - Allow any authenticated user to ONLY increment the 'inCartCount' field.
      allow update: if (resource.data.sellerId == request.auth.uid) ||
                     (request.auth != null &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inCartCount']) &&
                      request.resource.data.inCartCount == resource.data.inCartCount + 1);
                    
      // Allow delete only by the product owner.
      allow delete: if resource.data.sellerId == request.auth.uid;
    }

    // Orders can be read by the buyer and by admins.
    // Buyers can create orders.
    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.buyerId == request.auth.uid || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.userRole == 'admin');
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.userRole == 'admin';
    }

    // Categories are publicly readable
    match /categories/{categoryId} {
        allow read: if true;
        allow write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.userRole == 'admin';
    }
    
    // Other collections, keeping them restricted.
    match /payments/{paymentId} {
      allow read, write: if request.auth != null;
    }
    match /aiProductDescriptions/{descId} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
    match /admins/{adminId} {
      allow read, write: if get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SuperAdmin';
    }
    match /chats/{chatId} {
      // Allow create if the user is one of the two participants in the new chat.
      allow create: if request.auth != null && request.resource.data.participantIds.size() == 2 && request.auth.uid in request.resource.data.participantIds;
      // Allow read/update if the user is a participant in the existing chat.
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participantIds;
      
      match /messages/{messageId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
