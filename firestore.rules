
/**
 * @fileoverview Firestore Security Rules for the MoneyGo platform.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and a seller-ownership model for products and shops.
 * Orders and payments are accessible to both the buyer and the seller involved in the transaction.
 * AI-generated descriptions and categories are publicly readable but writable only with proper authorization.
 * Chat messages are only accessible to sender and receiver.
 * Admin users have special access defined in the 'admins' collection.
 *
 * Data Structure:
 * - /admins/{adminId}: Stores a list of admin user UIDs.
 * - /userProfiles/{userId}: Stores user profile data.
 * - /products/{productId}: Stores product data, including the sellerId.
 * - /orders/{orderId}: Stores order data, including buyerId, sellerId, and productId.
 * - /payments/{paymentId}: Stores payment data, linked to the orderId.
 * - /aiProductDescriptions/{aiProductDescriptionId}: Stores AI-generated product descriptions, linked to the productId.
 * - /categories/{categoryId}: Stores product category information.
 * - /sellerShops/{sellerShopId}: Stores seller shop information, linked to the sellerId.
 * - /chatMessages/{chatMessageId}: Stores chat messages between buyers and sellers, indexed by senderId and receiverId.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect privacy.
 * - Categories are publicly readable.
 * - Ambiguous relationships default to strict owner-only access.
 *
 * Denormalization for Authorization:
 * - Product documents contain `sellerId` to authorize updates and deletes.
 * - Order documents contain `buyerId` and `sellerId` to authorize access for both parties.
 * - SellerShop documents contain `sellerId` to authorize updates and deletes.
 *
 * Structural Segregation:
 * - User profiles are stored in a dedicated collection to enforce ownership and privacy.
 * - The 'admins' collection is separate and highly restricted.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * @description Check if the requesting user is an admin.
     * @returns boolean
     */
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    /**
     * @description Admin user data. Only readable by admins themselves. Writing is disallowed from the client.
     * @path /admins/{adminId}
     */
    match /admins/{adminId} {
      allow get: if isAdmin() && request.auth.uid == adminId;
      // Writing to the admins collection should only be managed from a secure backend environment.
      allow create, update, delete, list: if false; 
    }

    /**
     * @description Secure user profile data. Only the user can read and write their own profile. Admins can read any profile.
     * @path /userProfiles/{userId}
     * @allow (create) User with ID 'user123' creates their profile.
     * @allow (get) User with ID 'user123' reads their profile.
     * @allow (get) An admin reads any user's profile.
     * @allow (update) User with ID 'user123' updates their profile.
     * @allow (delete) User with ID 'user123' deletes their profile.
     * @deny (create) User with ID 'user123' tries to create profile for 'user456'.
     * @principle Enforces document ownership for all operations.
     */
    match /userProfiles/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Allow admins to list users
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Secure product data. Anyone can read product data, but only the seller can create, update, and delete. Admins can also delete.
     * @path /products/{productId}
     * @allow (get) Any user can read any product.
     * @allow (create) Seller with ID 'seller123' creates a product with sellerId 'seller123'.
     * @allow (update) Seller with ID 'seller123' updates a product they own (sellerId 'seller123').
     * @allow (delete) Seller with ID 'seller123' deletes a product they own (sellerId 'seller123').
     * @deny (create) User with ID 'buyer456' tries to create a product with sellerId 'seller123'.
     * @deny (update) User with ID 'buyer456' tries to update a product owned by 'seller123'.
     * @principle Allows public read access but enforces document ownership for writes.
     */
    match /products/{productId} {
      function isOwner(sellerId) {
        return request.auth != null && request.auth.uid == sellerId;
      }
      function isExistingOwner(sellerId) {
        return isOwner(sellerId) && resource != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.sellerId);
      allow delete: if isExistingOwner(resource.data.sellerId) || isAdmin();
    }

    /**
     * @description Secure order data. Only the buyer and seller involved in the order can read and write order data. Admins can read any order.
     * @path /orders/{orderId}
     * @allow (get) Buyer with ID 'buyer123' reads an order they placed (buyerId 'buyer123').
     * @allow (get) Seller with ID 'seller456' reads an order for their product (sellerId 'seller456').
     * @allow (create) Buyer with ID 'buyer123' creates an order with buyerId 'buyer123'.
     * @allow (update) Buyer with ID 'buyer123' updates an order they placed (buyerId 'buyer123').
     * @allow (delete) Buyer with ID 'buyer123' deletes an order they placed (buyerId 'buyer123').
     * @deny (get) User with ID 'other789' tries to read an order between 'buyer123' and 'seller456'.
     * @principle Enforces access control based on buyer and seller roles.
     */
    match /orders/{orderId} {
      function isBuyerOrSeller(buyerId, sellerId) {
        return request.auth != null && (request.auth.uid == buyerId || request.auth.uid == sellerId);
      }
       function isExistingBuyerOrSeller(buyerId, sellerId) {
        return isBuyerOrSeller(buyerId, sellerId) && resource != null;
      }
      allow get: if isBuyerOrSeller(resource.data.buyerId, resource.data.sellerId) || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth != null && request.resource.data.buyerId == request.auth.uid;
      allow update: if isExistingBuyerOrSeller(resource.data.buyerId, resource.data.sellerId) || isAdmin();
      allow delete: if isExistingBuyerOrSeller(resource.data.buyerId, resource.data.sellerId) || isAdmin();
    }

    /**
     * @description Secure payment data. Only accessible to parties involved in the order. Admins can read.
     * @path /payments/{paymentId}
     * @allow (get) Buyer/Seller reads a payment for their order.
     * @allow (create) Buyer creates a payment associated with their order.
     * @allow (update) Buyer updates payment info for their order.
     * @allow (delete) Buyer deletes a payment associated with their order.
     * @deny (get) Other user tries to read payment data.
     * @principle Restricts access based on order and user relationships.
     */
    match /payments/{paymentId} {
      function isBuyerOrSellerByOrderId(orderId) {
        return get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == request.auth.uid
               || get(/databases/$(database)/documents/orders/$(orderId)).data.sellerId == request.auth.uid;
      }
       function isExistingBuyerOrSellerByOrderId(orderId) {
        return isBuyerOrSellerByOrderId(orderId) && resource != null;
      }
      allow get: if (request.auth != null && isBuyerOrSellerByOrderId(resource.data.orderId)) || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth != null && isBuyerOrSellerByOrderId(request.resource.data.orderId);
      allow update: if request.auth != null && isExistingBuyerOrSellerByOrderId(resource.data.orderId);
      allow delete: if request.auth != null && isExistingBuyerOrSellerByOrderId(resource.data.orderId);
    }

    /**
     * @description Secure AI-generated product descriptions. Publicly readable, only the author can create, update, and delete.
     * @path /aiProductDescriptions/{aiProductDescriptionId}
     * @allow (get) Any user can read AI-generated descriptions.
     * @allow (create) Seller creates a description for their product.
     * @allow (update) Seller updates a description for their product.
     * @allow (delete) Seller deletes a description for their product.
     * @deny (create) Other user attempts to create a description.
     * @principle Allows public reads but enforces ownership for writes.
     */
    match /aiProductDescriptions/{aiProductDescriptionId} {
      function isProductOwner(productId) {
        return get(/databases/$(database)/documents/products/$(productId)).data.sellerId == request.auth.uid;
      }
      function isExistingProductOwner(productId) {
        return isProductOwner(productId) && resource != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if request.auth != null && isProductOwner(request.resource.data.productId);
      allow update: if request.auth != null && isExistingProductOwner(resource.data.productId);
      allow delete: if request.auth != null && isExistingProductOwner(resource.data.productId);
    }

    /**
     * @description Allow public read access to categories, but restrict write access to admins.
     * @path /categories/{categoryId}
     * @allow (get) Any user can read category information.
     * @principle Allows public read access. Write access is secured for admins.
     */
    match /categories/{categoryId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Secure seller shop data. Only the seller can create, update, and delete their shop. Admins can also manage.
     * @path /sellerShops/{sellerShopId}
     * @allow (get) Any user can read seller shops.
     * @allow (create) Seller creates their shop.
     * @allow (update) Seller updates their shop.
     * @allow (delete) Seller deletes their shop.
     * @deny (create) Other user attempts to create a shop.
     * @principle Enforces document ownership.
     */
    match /sellerShops/{sellerShopId} {
      function isOwner(sellerId) {
        return request.auth != null && request.auth.uid == sellerId;
      }
      function isExistingOwner(sellerId) {
        return isOwner(sellerId) && resource != null;
      }
      allow get: if true;
      allow list: if true;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.sellerId) || isAdmin();
      allow delete: if isExistingOwner(resource.data.sellerId) || isAdmin();
    }

    /**
     * @description Secure chat messages. Only the sender and receiver can access the message. Admins can read messages.
     * @path /chatMessages/{chatMessageId}
     * @allow (get) Sender/Receiver reads a message.
     * @allow (create) Sender creates a message.
     * @allow (update) Sender/Receiver updates a message.
     * @allow (delete) Sender deletes a message.
     * @deny (get) Other user tries to read the message.
     * @principle Restricts access based on sender and receiver IDs.
     */
    match /chatMessages/{chatMessageId} {
      function isSenderOrReceiver(senderId, receiverId) {
        return request.auth != null && (request.auth.uid == senderId || request.auth.uid == receiverId);
      }
      function isExistingSenderOrReceiver(senderId, receiverId) {
        return isSenderOrReceiver(senderId, receiverId) && resource != null;
      }
      allow get: if isSenderOrReceiver(resource.data.senderId, resource.data.receiverId) || isAdmin();
      allow list: if false;
      allow create: if request.auth != null && (request.resource.data.senderId == request.auth.uid || request.resource.data.receiverId == request.auth.uid);
      allow update: if isExistingSenderOrReceiver(resource.data.senderId, resource.data.receiverId);
      allow delete: if isExistingSenderOrReceiver(resource.data.senderId, resource.data.receiverId);
    }
  }
}
