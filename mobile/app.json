{
  "expo": {
    "name": "Vidnov",
    "owner": "vidnovs-team",
    "slug": "vidnov",
    "version": "1.1.1",
    "scheme": "vidnov",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "backgroundColor": "#0A0A0A",
    "primaryColor": "#FF4D2E",
    "android": {
      "package": "com.vidnov.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.POST_NOTIFICATIONS"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "vidnov.com", "pathPrefix": "/products" },
            { "scheme": "https", "host": "vidnov.com", "pathPrefix": "/sellers" },
            { "scheme": "https", "host": "vidnov.com", "pathPrefix": "/requests" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vidnov.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vidnov uses your photos so you can add images to listings and messages.",
          "cameraPermission": "Vidnov uses the camera so you can photograph items you sell or share."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://vidnov.com",
      "eas": {
        "projectId": "2a82790d-2c5b-4265-8200-82b4924e9548"
      }
    }
  }
}
