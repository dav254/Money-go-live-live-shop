{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "src/firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "apphosting": {
    "backendId": "live-shopping-backend",
    "rootDir": "/",
    "alwaysDeployFromSource": true,
    "ignore": [
      "node_modules/**",
      ".next/**",
      ".git/**",
      "functions/**",
      "webrtc-backend/**",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  }
}
