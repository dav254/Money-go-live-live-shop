{
  "entities": {
    "BuyerRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Buyer Request",
      "type": "object",
      "description": "Represents a broadcasted need from a buyer to find a specific product.",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "title": { "type": "string", "description": "The Requirements Summary." },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "minBudget": { "type": "number" },
        "maxBudget": { "type": "number" },
        "county": { "type": "string" },
        "area": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "selected", "closed"] },
        "requestType": { "type": "string", "enum": ["text", "video"] },
        "videoUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "buyerId", "title", "status", "createdAt"]
    },
    "CommissionTier": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CommissionTier",
      "type": "object",
      "description": "Represents a single performance-based commission tier set by a seller.",
      "properties": {
        "id": { "type": "string" },
        "sellerId": { "type": "string", "description": "The ID of the seller who created this tier." },
        "salesTarget": { "type": "number", "description": "The number of sales a reseller must achieve to unlock this tier." },
        "commissionBoost": { "type": "number", "description": "The percentage boost to the commission rate (e.g., 5 for a +5% boost)." },
        "description": { "type": "string", "description": "A short description of the tier's reward." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sellerId", "salesTarget", "commissionBoost", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/requests/{requestId}",
        "definition": {
          "entityName": "BuyerRequest",
          "schema": { "$ref": "#/backend/entities/BuyerRequest" },
          "description": "Stores broadcasted buyer needs for the marketplace leads pipe.",
          "params": [{ "name": "requestId", "description": "Unique ID for the request." }]
        }
      }
    ]
  }
}