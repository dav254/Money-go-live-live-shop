[debug] [2026-06-14T12:49:07.093Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/studio-1725493862-5cb95/rulesets {"name":"projects/studio-1725493862-5cb95/rulesets/8976781b-8760-48b5-8d2c-970c8a6ed971","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // =========================\n    // HELPER FUNCTIONS\n    // =========================\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isSignedIn() && request.auth.uid == userId;\n    }\n\n    function isAdmin() {\n      return isSignedIn() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.userRole == 'admin';\n    }\n\n    // =========================\n    // USER PROFILES\n    // =========================\n    match /userProfiles/{userId} {\n      allow read: if true;\n      allow create: if isSignedIn();\n      allow list: if isSignedIn() && (request.auth.uid == userId || resource.data.referredBy == request.auth.uid || isAdmin());\n      \n      match /{allPaths=**} {\n        allow read, write: if isOwner(userId);\n      }\n\n      allow update: if isOwner(userId) ||\n                      (isAdmin() &&\n                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verificationStatus', 'userRole', 'aiPoints'])) ||\n                      (request.resource.data.aiPoints == resource.data.aiPoints + 5 && isSignedIn());\n      allow delete: if isAdmin();\n    }\n\n    // =========================\n    // PRODUCT & LIVE ACCESS\n    // =========================\n    match /products/{productId} {\n      allow read, list: if true;\n      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;\n      allow update: if \n        (isSignedIn() && resource.data.sellerId == request.auth.uid &&\n         request.resource.data.diff(resource.data).affectedKeys()\n           .hasAny(['name', 'description', 'price', 'wasPrice', 'stock', 'category', 'tags', 'imageUrl', 'imageUrls', 'videoUrl', 'videoUrls', 'shippingCost', 'location', 'deliveryOptions', 'isResellable', 'commissionRate', 'updatedAt']))\n        ||\n        (isSignedIn() &&\n          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'viewCount', 'inCartCount']));\n      allow delete: if (isSignedIn() && resource.data.sellerId == request.auth.uid) || isAdmin();\n\n      match /reviews/{reviewId} {\n        allow read: if true;\n        allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;\n      }\n      \n      match /comments/{commentId} {\n        allow read, list: if true;\n        allow create: if isSignedIn();\n      }\n    }\n\n    match /sellerShops/{shopId} {\n      allow read: if true;\n      allow update: if isOwner(shopId) && !('followers' in request.resource.data);\n      allow write: if isOwner(shopId) || isAdmin();\n    }\n\n    match /liveSessions/{sessionId} {\n      allow read: if true;\n      allow write: if isOwner(sessionId) || isAdmin();\n      \n      match /chat/{messageId} {\n        allow read, write: if isSignedIn();\n      }\n    }\n\n    // =========================\n    // ORDERS & FINANCE\n    // =========================\n    match /orders/{orderId} {\n       allow list, read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || resource.data.resellerId == request.auth.uid || isAdmin());\n       allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;\n       allow update: if isSignedIn();\n       allow delete: if (isSignedIn() && resource.data.sellerId == request.auth.uid) || isAdmin();\n    }\n    \n    match /payouts/{payoutId} {\n      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());\n      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;\n      allow update: if isAdmin();\n    }\n\n    match /walletTransactions/{transactionId} {\n        allow create: if false; \n        allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());\n    }\n\n    // =========================\n    // SYSTEM & MARKETING\n    // =========================\n    match /homepageSlides/{slideId} {\n        allow read, list: if true;\n        allow write: if isAdmin();\n    }\n    \n    match /helpArticles/{articleId} {\n        allow read, list: if true;\n        allow write: if isAdmin();\n    }\n\n    match /supportTickets/{ticketId} {\n      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;\n      allow list, read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());\n      allow update, delete: if isAdmin();\n    }\n\n    match /complaints/{complaintId} {\n      allow create: if isSignedIn() && request.resource.data.complainantId == request.auth.uid;\n      allow read, update, delete: if isAdmin();\n    }\n\n    match /chats/{chatId} {\n      allow list, read, update: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());\n      allow create: if isSignedIn() && request.resource.data.participantIds.size() == 2 && request.auth.uid in request.resource.data.participantIds;\n      match /messages/{messageId} {\n        allow read, write: if isSignedIn();\n      }\n    }\n\n    match /notifications/{notificationId} {\n      allow read, write: if isSignedIn();\n    }\n\n    match /payments/{paymentId} {\n      allow read, create: if isSignedIn();\n    }\n\n    match /errorLogs/{errorId} {\n      // CRITICAL: Allow public creation of error logs to prevent crashes during guest session errors\n      allow create: if true;\n      allow read, list: if isAdmin();\n    }\n\n    // =========================\n    // DEFAULT DENY\n    // =========================\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}","name":"src/firestore.rules"}]},"createTime":"2026-06-14T12:49:07.020687Z","metadata":{"services":["cloud.firestore"]}}
